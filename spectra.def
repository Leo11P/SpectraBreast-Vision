# =============================================================================
#  spectra.def  —  Singularity definition file for the Spectra pipeline
#
#  Build (on Mufasa via SLURM):
#    sbatch build_spectra.sh
#
#  Run (GPU, on Mufasa via SLURM):
#    singularity exec --nv \
#        --bind /home/<user>/SpectraBreast-Vision/DATA:/data/DATA \
#        --bind /home/<user>/SpectraBreast-Vision/RESULTS:/data/RESULTS \
#        --bind /home/<user>/SpectraBreast-Vision/configs:/data/configs \
#        --bind /home/<user>/mast3r_checkpoints:/opt/mast3r/checkpoints \
#        spectra.sif \
#        spectra full --config /data/configs/default.yaml -s rerun.enabled=false
#
#  Notes:
#    - Base image: nvidia/cuda 13.0 + cudnn9 + devel (Ubuntu 22.04)
#    - PyTorch 2.10.0+cu130 from the official PyTorch wheel index
#    - MASt3R cloned from github.com/naver/mast3r (with --recursive for dust3r)
#    - asmk cloned from github.com/jenicek/asmk and installed as editable
#    - Spectra: copied from the local repo via %files (no internet needed)
#    - All pip packages pinned to the versions in requirements.txt
#    - MASt3R weights are NOT baked in: mount them at runtime with --bind
#    - rerun.enabled must be set to false for batch/non-interactive jobs
# =============================================================================

Bootstrap: docker
From: nvidia/cuda:13.0.0-cudnn-devel-ubuntu22.04

%labels
    Maintainer  SpectraBreast
    Version     0.2.0
    CUDA        13.0
    PyTorch     2.10.0+cu130

# =============================================================================
# Copy the local repo into the container at build time.
# This avoids depending on internet access during the build and ensures the
# exact local version (including uncommitted changes) is baked in.
# The path on the LEFT is relative to the directory where you run
# `sbatch build_spectra.sh` (i.e. ~/SpectraBreast-Vision/).
# =============================================================================
%files
    . /opt/SpectraBreast-Vision
    requirements.txt /tmp/requirements_orig.txt

%environment
    # ---- locale / timezone (avoids interactive prompts) --------------------
    export DEBIAN_FRONTEND=noninteractive
    export TZ=Europe/Rome
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8

    # ---- project layout ----------------------------------------------------
    export SPECTRA_ROOT=/opt/SpectraBreast-Vision
    export MAST3R_ROOT=/opt/mast3r
    export ASMK_ROOT=/opt/asmk

    # ---- Python path -------------------------------------------------------
    # asmk is installed as editable; keep its src on PYTHONPATH as a fallback
    export PYTHONPATH="${SPECTRA_ROOT}:${MAST3R_ROOT}:${ASMK_ROOT}:${PYTHONPATH}"

    # ---- CUDA / GPU --------------------------------------------------------
    export CUDA_HOME=/usr/local/cuda
    export PATH="${CUDA_HOME}/bin:${PATH}"
    export LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}"

    # ---- suppress Open3D headless warning ---------------------------------
    export OPEN3D_HEADLESS_RENDERING=1

    # ---- disable Rerun gRPC server (required for batch/non-interactive jobs)
    # This is a safety net; always also pass -s rerun.enabled=false at runtime.
    export RERUN_STRICT=0

%post
    set -eu

    # =========================================================================
    # 0. System packages
    # =========================================================================
    export DEBIAN_FRONTEND=noninteractive
    export TZ=Europe/Rome

    apt-get update -qq && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        ffmpeg \
        git \
        git-lfs \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libsm6 \
        libxext6 \
        libxrender1 \
        ninja-build \
        python3.10 \
        python3.10-dev \
        python3.10-distutils \
        python3-pip \
        unzip \
        wget \
    && rm -rf /var/lib/apt/lists/*

    # Make python3.10 the default python / pip
    update-alternatives --install /usr/bin/python  python  /usr/bin/python3.10 1
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1
    python -m pip install --upgrade pip setuptools wheel

    # =========================================================================
    # 1. PyTorch + torchvision (cu130 wheels — must come before everything else
    #    so the CUDA-aware builds of later packages link against the right libs)
    # =========================================================================
    pip install --no-cache-dir \
        torch==2.10.0+cu130 \
        torchvision==0.25.0+cu130 \
        --index-url https://download.pytorch.org/whl/cu130

    # =========================================================================
    # 2. Clone external repositories (mast3r and asmk)
    #    These are NOT in the local repo so still need internet access.
    #    The Spectra repo itself is already at /opt/SpectraBreast-Vision
    #    (copied via %files above — no git clone needed).
    # =========================================================================

    # --- MASt3R (includes dust3r as a submodule) ----------------------------
    # --- MASt3R ---
    git clone --recursive https://github.com/naver/mast3r.git /opt/mast3r
    pip install --no-cache-dir -r /opt/mast3r/requirements.txt
    pip install --no-cache-dir -r /opt/mast3r/dust3r/requirements.txt

    # --- asmk ---------------------------------------------------------------
    git clone https://github.com/jenicek/asmk.git /opt/asmk
    cd /opt/asmk
    # asmk has a Cython extension; build it in-place
    pip install --no-cache-dir cython numpy
    python setup.py build_ext --inplace || true   # non-fatal: pure-Python fallback exists
    pip install --no-cache-dir -e .

    # =========================================================================
    # 3. Install remaining dependencies directly from pyproject.toml
    #    (skip pinned requirements.txt — pins are for Python 3.12, we use 3.10)
    # =========================================================================
    cd /opt/SpectraBreast-Vision
    pip install --no-cache-dir \
        numpy scipy pyyaml pyaml pydantic typer rich tqdm \
        trimesh rtree pillow einops huggingface-hub \
        jaxtyping opencv-contrib-python \
        roma safetensors openpyxl scikit-learn || true

   

    # =========================================================================
    # 4. Install Spectra itself (editable, so `spectra` CLI is on PATH)
    #    The repo was already copied to /opt/SpectraBreast-Vision via %files.
    # =========================================================================
    cd /opt/SpectraBreast-Vision
    pip install --no-cache-dir -e .

    # =========================================================================
    # 5. MASt3R model weights — NOT downloaded here.
    #    Mount them at runtime with:
    #      --bind /home/<user>/mast3r_checkpoints:/opt/mast3r/checkpoints
    #    This keeps the .sif ~2 GB smaller and avoids hitting HuggingFace
    #    during the build (which can time-out on the build QOS).
    # =========================================================================
    mkdir -p /opt/mast3r/checkpoints

    # =========================================================================
    # 6. Smoke-test (non-fatal — avoids breaking the build on headless nodes)
    # =========================================================================
    python -c "import torch; print('torch', torch.__version__, '| CUDA', torch.cuda.is_available())" || true
    python -c "import spectra; print('spectra', spectra.__version__)" || true

    # Clean up pip cache and temp files
    pip cache purge
    rm -rf /tmp/requirements_filtered.txt /tmp/requirements_orig.txt /root/.cache

%runscript
    # Default: run the spectra CLI, forwarding all arguments.
    # Always pass -s rerun.enabled=false for batch/non-interactive jobs:
    #   singularity run spectra.sif full --config /data/configs/default.yaml \
    #       -s rerun.enabled=false
    exec spectra "$@"

%help
    Spectra unified pipeline container (MASt3R-SfM + HSI→Mesh registration).

    Repos baked in at build time:
      /opt/SpectraBreast-Vision   — main Spectra package (copied from local repo)
      /opt/mast3r                 — MASt3R + dust3r (cloned from GitHub)
      /opt/asmk                   — ASMK retrieval library (cloned from GitHub)

    MASt3R weights are NOT baked in — mount them at runtime:
      --bind /home/<user>/mast3r_checkpoints:/opt/mast3r/checkpoints

    Typical usage on Mufasa (inside run_spectra.sh sbatch script)
    -------------------------------------------------------------
    # Full pipeline (vision + registration):
    singularity exec --nv \
        --bind /home/<user>/SpectraBreast-Vision/DATA:/data/DATA \
        --bind /home/<user>/SpectraBreast-Vision/RESULTS:/data/RESULTS \
        --bind /home/<user>/SpectraBreast-Vision/configs:/data/configs \
        --bind /home/<user>/mast3r_checkpoints:/opt/mast3r/checkpoints \
        spectra.sif \
        spectra full --config /data/configs/default.yaml \
            --sample RUBIK \
            -s rerun.enabled=false

    # Vision only:
    singularity exec --nv [...binds...] spectra.sif \
        spectra vision --config /data/configs/default.yaml -s rerun.enabled=false

    # Registration only:
    singularity exec --nv [...binds...] spectra.sif \
        spectra registration --config /data/configs/default.yaml

    # Interactive shell (for debugging):
    srun --qos=gpulight --gres=gpu:3g.20gb:1 --pty /bin/bash
    module load amd/singularity
    singularity shell --nv \
        --bind /home/<user>/SpectraBreast-Vision/DATA:/data/DATA \
        --bind /home/<user>/SpectraBreast-Vision/RESULTS:/data/RESULTS \
        --bind /home/<user>/mast3r_checkpoints:/opt/mast3r/checkpoints \
        spectra.sif
